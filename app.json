{
  "expo": {
    "name": "NextUp",
    "slug": "next-up-mobile",
    "scheme": "nextup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nextup.mobile"
    },
    "android": {
      "package": "com.nextup.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0c0c10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "NextUp uses a photo you choose as your profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://next-up.capstone.uamishub.com"
    }
  }
}
